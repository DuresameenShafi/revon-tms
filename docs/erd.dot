digraph REVON {
 rankdir=LR; splines=polyline; nodesep=0.5; ranksep=1.1; bgcolor="white";
 node [shape=plain fontname="Helvetica"]; edge [fontname="Helvetica" fontsize=10 color="#475569"];
 customers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#0d1b18"><FONT COLOR="white"><B>CUSTOMERS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fef3c7">customer_id PK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">full_name</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">company</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">phone UK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">email UK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">city</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">address</TD></TR></TABLE>>];
 models [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#0d1b18"><FONT COLOR="white"><B>MODELS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fef3c7">model_id PK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">model_name</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">variant</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">engine_cc</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">battery_kwh</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">range_km</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">top_speed_kmh</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">base_price</TD></TR></TABLE>>];
 bikes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#0d1b18"><FONT COLOR="white"><B>BIKES</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fef3c7">bike_id PK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">vin UK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">bike_type</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">model_name</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">color</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">make_year</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">battery_kwh</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">status</TD></TR></TABLE>>];
 staff [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#0d1b18"><FONT COLOR="white"><B>STAFF</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fef3c7">staff_id PK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">full_name</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">employee_no UK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">role</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">hire_date</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">experience_yrs</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">status</TD></TR></TABLE>>];
 orders [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#0e9f6e"><FONT COLOR="white"><B>ORDERS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fef3c7">order_id PK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">order_no UK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e0f2fe">customer_id FK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e0f2fe">model_id FK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e0f2fe">bike_id FK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e0f2fe">staff_id FK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">quantity</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">order_date</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">delivery_date</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">status</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">total_price</TD></TR></TABLE>>];
 payments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#0d1b18"><FONT COLOR="white"><B>PAYMENTS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fef3c7">payment_id PK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e0f2fe">order_id FK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">amount</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">method</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">payment_date</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">reference_no</TD></TR></TABLE>>];
 service_records [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#0d1b18"><FONT COLOR="white"><B>SERVICE_RECORDS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fef3c7">service_id PK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e0f2fe">bike_id FK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">service_date</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">service_type</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">cost</TD></TR></TABLE>>];
 customers -> orders [label="places  1:N" arrowhead=crowodot arrowtail=tee dir=both];
 models -> orders [label="ordered as  1:N" arrowhead=crowodot arrowtail=tee dir=both];
 bikes -> orders [label="fulfils  1:N (optional)" arrowhead=crowodot arrowtail=tee dir=both];
 staff -> orders [label="handles  1:N (optional)" arrowhead=crowodot arrowtail=tee dir=both];
 orders -> payments [label="paid by  1:N" arrowhead=crowodot arrowtail=tee dir=both];
 bikes -> service_records [label="serviced in  1:N" arrowhead=crowodot arrowtail=tee dir=both];
}